{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "bma.agents.session_state",
    "title": "BMA Session State",
    "description": "Cross-plugin runtime state. Tracks what is currently active across the entire agent system. This file is runtime-only and must be git-ignored.",
    "type": "object",
    "required": [
        "active_feature",
        "active_plugins",
        "symphony_mode",
        "inter_plugin_contracts"
    ],
    "additionalProperties": false,
    "properties": {
        "active_feature": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable name of the feature currently being built. Must match the feature field in all active plugin_state.json files.",
            "examples": [
                "celery-beat periodic jobs",
                "customer address API",
                "razorpay webhook handler"
            ]
        },
        "active_plugins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "List of plugins currently participating in this session. Order matters in symphony mode — defines execution sequence.",
            "items": {
                "type": "string",
                "enum": [
                    "backend-plugin",
                    "frontend-plugin",
                    "infra-plugin"
                ]
            },
            "examples": [
                [
                    "backend-plugin"
                ],
                [
                    "backend-plugin",
                    "frontend-plugin"
                ],
                [
                    "backend-plugin",
                    "frontend-plugin",
                    "infra-plugin"
                ]
            ]
        },
        "symphony_mode": {
            "type": "boolean",
            "description": "When true, multiple plugins are coordinating on the same feature. The orchestrator enforces inter-plugin contracts and execution order. Must be false if active_plugins has only one entry.",
            "default": false
        },
        "inter_plugin_contracts": {
            "type": "object",
            "description": "Contracts between plugins. Populated by upstream plugins when they produce outputs a downstream plugin depends on. Empty when symphony_mode is false.",
            "additionalProperties": false,
            "properties": {
                "backend_to_frontend": {
                    "$ref": "#/$defs/plugin_contract"
                },
                "backend_to_infra": {
                    "$ref": "#/$defs/plugin_contract"
                },
                "frontend_to_infra": {
                    "$ref": "#/$defs/plugin_contract"
                }
            }
        }
    },
    "$defs": {
        "plugin_contract": {
            "type": "object",
            "required": [
                "status",
                "produced_by_stage"
            ],
            "additionalProperties": false,
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "ready"
                    ],
                    "description": "pending = upstream plugin has not yet produced this output. ready = downstream plugin may proceed.",
                    "default": "pending"
                },
                "produced_by_stage": {
                    "type": "string",
                    "description": "The stage in the upstream plugin that produces this contract. Downstream plugin waits until this stage is in completed_stages."
                },
                "new_endpoints": {
                    "type": "array",
                    "description": "API endpoints exposed by the backend plugin for the frontend to consume.",
                    "items": {
                        "type": "object",
                        "required": [
                            "method",
                            "path"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "method": {
                                "type": "string",
                                "enum": [
                                    "GET",
                                    "POST",
                                    "PUT",
                                    "PATCH",
                                    "DELETE"
                                ]
                            },
                            "path": {
                                "type": "string",
                                "description": "URL path relative to API root.",
                                "examples": [
                                    "/api/invoices/generate/",
                                    "/api/payments/{id}/verify/"
                                ]
                            },
                            "request_schema": {
                                "type": "object",
                                "description": "Shape of the request body. Free-form — defined by the Architect."
                            },
                            "response_schema": {
                                "type": "object",
                                "description": "Shape of the response body. Free-form — defined by the Architect."
                            },
                            "auth_required": {
                                "type": "boolean",
                                "default": true
                            },
                            "tenant_scoped": {
                                "type": "boolean",
                                "description": "Whether this endpoint operates within a tenant schema context.",
                                "default": true
                            }
                        }
                    }
                },
                "new_env_vars": {
                    "type": "array",
                    "description": "New environment variables introduced by this feature that downstream plugins or infra must be aware of.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "required"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "required": {
                                "type": "boolean"
                            },
                            "default": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    }
                },
                "new_services": {
                    "type": "array",
                    "description": "New Docker services or external dependencies introduced that infra must account for.",
                    "items": {
                        "type": "string"
                    },
                    "examples": [
                        [
                            "valkey-broker",
                            "worker-heavy"
                        ]
                    ]
                }
            }
        }
    }
}
