{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bma.agents.design_contract",
  "title": "BMA Frontend Design Contract",
  "description": "Schema for the structured design contract shared between the Designer, Linter, Coder, and Critic.",
  "type": "object",
  "required": [
    "component_name",
    "tier",
    "vuetify_components",
    "design_tokens",
    "states",
    "animation_spec",
    "wireframe",
    "review",
    "code_files"
  ],
  "additionalProperties": false,
  "properties": {
    "component_name": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]*$",
      "description": "Component name in PascalCase."
    },
    "tier": {
      "type": "string",
      "enum": [
        "generic",
        "layout",
        "view"
      ],
      "description": "The architectural tier of the component."
    },
    "vuetify_components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "List of Vuetify components used (e.g., v-btn, v-card)."
    },
    "design_tokens": {
      "type": "object",
      "description": "Design tokens mapping to CSS variables.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Interactive states (e.g. hover, active, focus, disabled)."
    },
    "animation_spec": {
      "type": "string",
      "description": "Brief description of custom animations if any."
    },
    "wireframe": {
      "type": "object",
      "required": [
        "svg_content",
        "review_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "svg_content": {
          "type": "string",
          "description": "SVG visual representation markup."
        },
        "review_mode": {
          "type": "string",
          "enum": [
            "text",
            "image"
          ],
          "description": "Mode of review (critique skills use rasterized image mode)."
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "iteration",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "code_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files generated by the Coder corresponding to this design."
    }
  }
}
